# --- Servidor ---
PORT=3001
# Ruta del archivo SQLite (haz copias de seguridad de este archivo).
DB_PATH=data/citofonia.db

# OBLIGATORIO en producción: mínimo 32 caracteres aleatorios.
#   openssl rand -hex 32
JWT_SECRET=
SESSION_HOURS=8

# Orígenes extra permitidos para el WebSocket (lista separada por comas).
# Normalmente no hace falta: se acepta el propio host.
ALLOWED_ORIGINS=

# --- Primer arranque en producción (base de datos vacía) ---
# Crea el conjunto y el primer administrador. Después puedes quitarlas.
COMPLEX_NAME="Mi Conjunto Residencial"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Desarrollo ---
# Contraseña de los usuarios demo. Si no se define, se genera una y se imprime en consola.
DEMO_PASSWORD=

# --- Puerta / relé ---
# Sin RELAY_URL la puerta es SIMULADA (no abre nada real).
# Con RELAY_URL, el servidor hace POST firmado (HMAC-SHA256 en X-Signature) al controlador.
RELAY_URL=
RELAY_SECRET=
DOOR_OPEN_SECONDS=5
# Segundos que suena una llamada antes de pasar a "perdida".
CALL_TIMEOUT_SECONDS=30
